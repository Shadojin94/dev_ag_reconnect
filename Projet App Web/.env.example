# Copier ce fichier en .env — .env n'est jamais commité.
#
# Vite n'expose au navigateur que les variables préfixées VITE_.
# Tout ce qui porte ce préfixe se retrouve dans le bundle et devient
# lisible par n'importe quel visiteur : aucune clé secrète ici.

VITE_API_URL=http://localhost:3000

# --- Serveur : chat LLM (voir docs/CHAT-LLM.md) ---
# Sans préfixe VITE_ : lues uniquement par le middleware Vite (npm run dev /
# npm run preview), jamais envoyées au navigateur ni incluses dans le bundle.
# NVIDIA_API_KEY vide = mode sans IA.
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=moonshotai/kimi-k3
LLM_REASONING_EFFORT=medium
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=1
